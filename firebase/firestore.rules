rules_version = '2';

// Mr. Wordler: family online (spec-08).
//
// What lives here, and who can see it:
//   users/{uid}                    the account's own birth year and family. Only that account.
//   codes/{CODE}                   family code -> family id, family name and the grown-ups'
//                                  first names. Any signed-in account that knows the code
//                                  (looked up one at a time; it can't be listed).
//   families/{fid}                 the family's name and code. Members only.
//   families/{fid}/members/{uid}   first name, color, word level, adult or not, the day they
//                                  last played. Members only.
//                                  Since spec-09 also their buildings (word -> count) and which
//                                  are new today; never the village's words or letters.
//                                  Since spec-10 also a letter they asked the family for today.
//   families/{fid}/days/{day}      the family word that day: who uncovered which letter
//                                  positions, and whether it was found. Members only.
//   families/{fid}/notes/{id}      gifts (one letter) and cheers (a sticker) between members.
//                                  Members only; nothing typed.
//   families/{fid}/square/state    the Town Square (spec-13): what's being built, bricks,
//                                  what's finished, this week's vote. Members only.
//   families/{fid}/requests/{uid}  a child asking to join. The child and the family's grown-ups.
//
// Nothing about a child is readable by anyone outside the family, and a
// new member (child or grown-up) only gets in when a grown-up already in the
// family says yes. A family code alone is not enough.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function fullAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function memberPath(fid, uid) { return /databases/$(db)/documents/families/$(fid)/members/$(uid); }
    function familyPath(fid) { return /databases/$(db)/documents/families/$(fid); }
    function isMember(fid) { return signedIn() && exists(memberPath(fid, me())); }
    function isAdult(fid) { return isMember(fid) && get(memberPath(fid, me())).data.adult == true; }
    // The family as it will be once this write (or batch) is done.
    function familyAfter(fid) { return getAfter(familyPath(fid)).data; }
    function memberFields() {
      return request.resource.data.keys().hasOnly(['name', 'colorIndex', 'level', 'adult', 'playedDay', 'joinCode', 'joinedAt',
                                                   'buildings', 'newBuildings', 'newOn', 'wants', 'wantsOn'])
        && (!('wants' in request.resource.data) || request.resource.data.wants.matches('^[A-Z]$'))
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.colorIndex is int
        && request.resource.data.level is string
        && (!('buildings' in request.resource.data) || (request.resource.data.buildings is map
                                                        && request.resource.data.buildings.size() <= 20))
        && (!('newBuildings' in request.resource.data) || (request.resource.data.newBuildings is list
                                                           && request.resource.data.newBuildings.size() <= 20));
    }
    function dayFields() {
      return request.resource.data.keys().hasOnly(['found', 'solved', 'solvedEarly', 'solvedBy', 'streak'])
        && request.resource.data.found is map
        && request.resource.data.solved is bool
        && request.resource.data.streak is int;
    }

    function squareFields() {
      return request.resource.data.keys().hasOnly(['building', 'bricks', 'spent', 'goal', 'built', 'vote', 'finishedOn'])
        && request.resource.data.bricks is int
        && request.resource.data.spent is int
        && request.resource.data.goal is int
        && request.resource.data.built is list && request.resource.data.built.size() <= 200;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      // Made with a new family, or when a grown-up asks for a new code.
      allow create: if fullAccount()
        && getAfter(memberPath(request.resource.data.familyId, me())).data.adult == true
        && familyAfter(request.resource.data.familyId).code == code;
      // The family's name and its grown-ups' names change over time.
      allow update: if isAdult(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId;
      allow delete: if isAdult(resource.data.familyId)
        || (signedIn() && !existsAfter(familyPath(resource.data.familyId)));
    }

    match /families/{fid} {
      allow read: if isMember(fid);
      allow create: if fullAccount()
        && request.resource.data.createdBy == me()
        && getAfter(memberPath(fid, me())).data.adult == true;
      allow update: if isAdult(fid);
      // A grown-up, or the very last member leaving.
      allow delete: if isAdult(fid);

      match /members/{uid} {
        allow read: if isMember(fid);
        allow create: if memberFields() && (
          // The grown-up who starts the family, in the same write as the family.
          (fullAccount() && me() == uid
            && request.resource.data.adult == true
            && !exists(familyPath(fid))
            && familyAfter(fid).createdBy == me())
          ||
          // Everyone else: a grown-up in the family says yes to their request.
          // Only someone who said they are 18 or over can become a grown-up.
          (isAdult(fid)
            && exists(/databases/$(db)/documents/families/$(fid)/requests/$(uid))
            && (request.resource.data.adult == false
                || get(/databases/$(db)/documents/families/$(fid)/requests/$(uid)).data.group == 'adult'))
        );
        // Your own name, color, level and the day you played. Nobody can
        // make themselves a grown-up.
        allow update: if memberFields() && me() == uid
          && request.resource.data.adult == resource.data.adult;
        allow delete: if signedIn() && (me() == uid || isAdult(fid));
      }

      // The family word, one document a day (spec-09). Members only; each
      // member adds only their own letters, and a found word stays found.
      match /days/{day} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && dayFields()
          && request.resource.data.found.keys().hasOnly([me()]);
        allow update: if isMember(fid) && dayFields()
          && request.resource.data.found.diff(resource.data.found).affectedKeys().hasOnly([me()])
          && !(resource.data.solved == true && request.resource.data.solved == false);
        // Only while closing the family, by its last member.
        allow delete: if isMember(fid);
      }

      // Gifts and cheers (spec-10): from one member to another, as yourself.
      // A gift is one letter; a cheer is a sticker id. Nothing is typed.
      match /notes/{id} {
        allow read: if isMember(fid);
        allow create: if isMember(fid)
          && request.resource.data.keys().hasOnly(['kind', 'from', 'to', 'day', 'letter', 'sticker', 'about', 'at'])
          && request.resource.data.from == me()
          && request.resource.data.to is string && request.resource.data.to != me()
          && exists(memberPath(fid, request.resource.data.to))
          && request.resource.data.day is string && request.resource.data.day.size() <= 10
          && ((request.resource.data.kind == 'gift' && request.resource.data.letter.matches('^[A-Z]$'))
              || (request.resource.data.kind == 'cheer' && request.resource.data.sticker.matches('^[a-z]{1,12}$')))
          && (!('about' in request.resource.data) || (request.resource.data.about is string
                                                      && request.resource.data.about.size() <= 24));
        allow update: if false;
        // The receiver or sender tidies up; or the last member closing the family.
        allow delete: if isMember(fid) && (resource.data.to == me() || resource.data.from == me()
                                           || !existsAfter(familyPath(fid)));
      }

      // The Town Square (spec-13): one document, changed in a transaction.
      // Bricks only go up, at most 5 at a time; finished buildings stay.
      match /square/{doc} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && doc == 'state' && squareFields()
          && request.resource.data.bricks <= 5
          && request.resource.data.spent == 0;
        allow update: if isMember(fid) && squareFields()
          && request.resource.data.bricks >= resource.data.bricks
          && request.resource.data.bricks <= resource.data.bricks + 5
          && request.resource.data.spent >= resource.data.spent
          && request.resource.data.built.size() >= resource.data.built.size();
        // Only while closing the family, by its last member.
        allow delete: if isMember(fid);
      }

      match /requests/{uid} {
        allow create: if signedIn() && me() == uid
          && request.resource.data.joinCode == get(familyPath(fid)).data.code
          && request.resource.data.keys().hasOnly(['name', 'colorIndex', 'level', 'birthYear', 'group', 'joinCode', 'at']);
        allow read, delete: if signedIn() && (me() == uid || isAdult(fid));
      }
    }
  }
}
